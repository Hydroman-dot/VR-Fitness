@echo off
setlocal
title VR Fitness V11.17 Preview Setup
set "SELF=%~f0"
set "TMPPS=%TEMP%\vrfitness_v1117_%RANDOM%_%RANDOM%.ps1"

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
 "$raw=[IO.File]::ReadAllText($env:SELF); $marker='__VRFITNESS_V1117_PAYLOAD__'; $i=$raw.LastIndexOf($marker); if($i -lt 0){exit 2}; $b64=$raw.Substring($i+$marker.Length).Trim(); [IO.File]::WriteAllBytes($env:TMPPS,[Convert]::FromBase64String(($b64 -replace '\s','')))"

if errorlevel 1 (
 echo Installer konnte nicht vorbereitet werden.
 pause
 exit /b 1
)

powershell -NoProfile -ExecutionPolicy Bypass -File "%TMPPS%"
set "RC=%ERRORLEVEL%"
del /q "%TMPPS%" >nul 2>&1
if not "%RC%"=="0" pause
exit /b %RC%

